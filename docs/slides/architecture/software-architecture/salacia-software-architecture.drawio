        <mxCell id="kFMdSpQf1mPVwam6vj60-7" parent="1" style="text;whiteSpace=wrap;html=1;align=left;" value="&lt;span style=&quot;caret-color: rgb(0, 29, 53); color: rgb(0, 29, 53); font-family: &amp;quot;Google Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; font-style: normal; font-variant-caps: normal; font-weight: 500; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration: none; float: none; display: inline !important;&quot;&gt;LLM model&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;caret-color: rgb(0, 29, 53); color: rgb(0, 29, 53); font-family: &amp;quot;Google Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; font-style: normal; font-variant-caps: normal; font-weight: 500; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration: none; float: none; display: inline !important;&quot;&gt;(Microsoft Foundry)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;caret-color: rgb(0, 29, 53); color: rgb(0, 29, 53); font-family: &amp;quot;Google Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; font-style: normal; font-variant-caps: normal; font-weight: 500; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration: none; float: none; display: inline !important;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#001d35&quot; face=&quot;Google Sans, Helvetica Neue, sans-serif&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 29, 53); background-color: rgb(255, 255, 255);&quot;&gt;implements ReAct agent loop where agent&lt;br&gt;1. Reasoning - reason about action to take based on tool result&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#001d35&quot; face=&quot;Google Sans, Helvetica Neue, sans-serif&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 29, 53); background-color: rgb(255, 255, 255);&quot;&gt;2. Action - pick a tool or skill to execute&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#001d35&quot; face=&quot;Google Sans, Helvetica Neue, sans-serif&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 29, 53); background-color: rgb(255, 255, 255);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#001d35&quot; face=&quot;Google Sans, Helvetica Neue, sans-serif&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 29, 53); background-color: rgb(255, 255, 255);&quot;&gt;3. Observe - tool result&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#001d35&quot; face=&quot;Google Sans, Helvetica Neue, sans-serif&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 29, 53); background-color: rgb(255, 255, 255);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#001d35&quot; face=&quot;Google Sans, Helvetica Neue, sans-serif&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 29, 53); background-color: rgb(255, 255, 255);&quot;&gt;4. backs to Reasoning&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="245" x="-2232" y="2960" as="geometry" />
        </mxCell>
